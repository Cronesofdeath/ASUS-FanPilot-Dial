<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ASUS FanPilot Dial" Width="650" Height="550" MinWidth="550" MinHeight="405" Background="{DynamicResource StudioCanvas}" Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border BorderBrush="{DynamicResource StudioLine}" BorderThickness="1"><ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Root" Margin="20,12,20,8">
    <Grid Height="36" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="29" Height="29" Background="{DynamicResource StudioControl}" CornerRadius="7" Margin="0,0,10,0"><Path Data="M 3,17 L 9,3 L 15,17 M 6,12 L 12,12 M 17,4 L 22,4 M 17,9 L 21,9" Stroke="{DynamicResource StudioAccent}" StrokeThickness="1.8" Stretch="Uniform" Margin="6"/></Border><TextBlock Text="ASUS FanPilot" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="{DynamicResource StudioControl}" BorderThickness="0" CornerRadius="4" Padding="5,2" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="DIAL" Foreground="{DynamicResource StudioAccent}" FontSize="9" FontWeight="SemiBold"/></Border></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenSettings" Style="{StaticResource CaptionButton}" ToolTip="Settings" AutomationProperties.Name="Open settings" Margin="0,0,8,0"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button><Button x:Name="Minimize" Content="−" Style="{StaticResource CaptionButton}" ToolTip="Minimize to tray" AutomationProperties.Name="Minimize to tray" FontSize="19"/><Button x:Name="WindowClose" Content="×" Style="{StaticResource CloseCaption}" ToolTip="Close" AutomationProperties.Name="Close window" FontSize="20"/></StackPanel>
    </Grid>
    <Border x:Name="Notice" Visibility="Collapsed" Background="{DynamicResource StudioNoticeSurface}" BorderBrush="{DynamicResource StudioNoticeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{DynamicResource StudioNoticeText}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="Retry" Content="Retry" Margin="0,0,8,0"/><Button x:Name="OpenLog" Content="View log"/><Button x:Name="ExitUnconfirmed" Content="Exit anyway…" Margin="8,0,0,0" Visibility="Collapsed"/></StackPanel></StackPanel></Border>
    <Border BorderBrush="{DynamicResource StudioLine}" BorderThickness="0,0,0,1" Padding="0,8">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="Cpu" Margin="0,0,14,0"/><TextBlock x:Name="Gpu"/></StackPanel><TextBlock x:Name="ModeLinkState" FontWeight="SemiBold"/></DockPanel>
    </Border>
    <UniformGrid x:Name="FanCards" Columns="2" Margin="0,8,0,4"/>
    <Border Padding="0,12,0,6">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="118"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
          <TextBlock x:Name="ControlStatus" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="Badge" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource StudioMutedText}"/>
        </StackPanel>
        <StackPanel Grid.Row="1"><TextBlock x:Name="CoolingLabel" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/><ComboBox x:Name="ActiveProfile" HorizontalAlignment="Stretch" ToolTip="Follow G-Helper or select FanPilot's cooling profile." SelectedIndex="3" Background="{DynamicResource StudioPanel}" AutomationProperties.Name="Active cooling profile"><ComboBoxItem Content="Silent"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Turbo"/><ComboBoxItem Content="Follow G-Helper"/></ComboBox></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
          <TextBlock Text="CONTROL METHOD" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
          <ComboBox x:Name="ControlMode" SelectedIndex="0" Background="{DynamicResource StudioPanel}" AutomationProperties.Name="Control mode">
            <ComboBoxItem Content="Fixed PWM"/>
            <ComboBoxItem Content="Automatic curve"/>
          </ComboBox>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="4" VerticalAlignment="Bottom"><CheckBox x:Name="ManualToggle" Style="{StaticResource RunControl}" AutomationProperties.Name="Toggle fan control" IsEnabled="False">
          <TextBlock x:Name="ControlAction" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource StudioOnAccent}"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ManualToggle}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </CheckBox></Grid>
      </Grid><Grid x:Name="FixedTarget" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="Target" Text="90" FontFamily="Bahnschrift" FontSize="31" FontWeight="SemiBold" MinWidth="60" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="PWM percentage"/><TextBlock x:Name="Unit" Text="%" FontSize="19" Foreground="{DynamicResource StudioMutedText}" Margin="4,0,10,2" VerticalAlignment="Bottom"/><TextBlock x:Name="TargetCaption" Text="PWM DUTY" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Minus" Content="−" Width="32" Padding="0" FontSize="18" Margin="0,0,6,0" AutomationProperties.Name="Decrease duty"/><Button x:Name="Plus" Content="+" Width="32" Padding="0" FontSize="18" AutomationProperties.Name="Increase duty"/></StackPanel></Grid>
      <TextBlock x:Name="SpeedTarget" Text="Direct PWM control" Foreground="{DynamicResource StudioAccent}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <Slider x:Name="TargetSlider" Minimum="40" Maximum="100" Value="90" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True" Margin="-3,2,-3,0" AutomationProperties.Name="PWM percentage slider"/>
      <Grid x:Name="FixedRange"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RangeMin" Text="40%" Foreground="{DynamicResource StudioMutedText}" FontSize="10"/><TextBlock x:Name="RangeMax" Grid.Column="1" Text="100%" Foreground="{DynamicResource StudioMutedText}" FontSize="10"/></Grid>


      <DockPanel Margin="0,14,0,0" LastChildFill="True">
        <Button DockPanel.Dock="Right" x:Name="EditCurves" Content="Edit curves ↗" Width="118"
                Background="{DynamicResource StudioPanel}" Padding="8,5" AutomationProperties.Name="Edit fan curves"/>
        <TextBlock x:Name="ModeHelp" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource StudioMutedText}" TextWrapping="Wrap"/>
      </DockPanel>
    </StackPanel></Border>

    </StackPanel></ScrollViewer></Border>
</Window>