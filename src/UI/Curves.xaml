<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASUS FanPilot Dial — Fan curves" Width="960" Height="660"
        MinWidth="900" MinHeight="590" Background="{DynamicResource StudioCanvas}" Foreground="{DynamicResource StudioText}"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Border BorderBrush="{DynamicResource StudioLine}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto" MinHeight="48"/>
      </Grid.RowDefinitions>

      <Grid Margin="16,6,12,6">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Curve workspace" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0">
          <TextBlock x:Name="RunningStatus" Text="Firmware control" Foreground="{DynamicResource StudioText}" FontWeight="SemiBold"/>
          <TextBlock x:Name="ModeSource" Foreground="{DynamicResource StudioMutedText}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="CurvesMinimize" Content="−" Style="{StaticResource CaptionButton}" FontSize="18" ToolTip="Minimize" AutomationProperties.Name="Minimize curves window"/>
          <Button x:Name="CurvesClose" Content="×" Style="{StaticResource CloseCaption}" FontSize="22" ToolTip="Close curve editor" AutomationProperties.Name="Close curve editor"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioLine}" BorderThickness="0,1,0,1" Padding="14,5">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TabControl x:Name="ProfileTabs" BorderThickness="0" Background="Transparent" SelectedIndex="1" VerticalAlignment="Center"
                      AutomationProperties.Name="Cooling profile" HorizontalAlignment="Left" Template="{StaticResource CurveTabs}">
            <TabItem Header="Silent" Width="84" HorizontalContentAlignment="Center" Padding="0,7"/>
            <TabItem Header="Balanced" Width="84" HorizontalContentAlignment="Center" Padding="0,7"/>
            <TabItem Header="Turbo" Width="84" HorizontalContentAlignment="Center" Padding="0,7"/>
          </TabControl>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PointToggle" Content="Edit point…" Width="116" Margin="0,0,6,0" ToolTip="Enter exact values for the selected point"/>
            <ToggleButton x:Name="AdvancedToggle" Content="Advanced tuning" Width="150" MinHeight="34" Padding="12,6"
                          FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StudioText}" Cursor="Hand"
                          FocusVisualStyle="{StaticResource ButtonKeyboardFocus}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Surface" Background="{DynamicResource StudioControl}" BorderBrush="{DynamicResource StudioLine}"
                          BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <ContentPresenter VerticalAlignment="Center"/>
                      <Path x:Name="Chevron" Data="M 5,0 L 0,4 L 5,8" Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="1.4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Surface" Property="BorderBrush" Value="#7F91AE"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Surface" Property="Background" Value="{DynamicResource StudioSelected}"/>
                      <Setter TargetName="Chevron" Property="Data" Value="M 0,0 L 5,4 L 0,8"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </StackPanel>

        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="14,8,14,6">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <UniformGrid Columns="2" Margin="-6,0,-6,8">
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="12,10" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="3,0,3,4">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Fan 1" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Draft  /  estimated RPM" Foreground="{DynamicResource StudioMutedText}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Fan1Rpm" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource StudioAccent}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="live RPM" Foreground="{DynamicResource StudioMutedText}" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom"/>
                  </StackPanel>
                </Grid>
                <Grid x:Name="CpuPlot" Grid.Row="1"/>
                <TextBlock Grid.Row="2" Text="Temperature (°C)" Foreground="{DynamicResource StudioMutedText}" HorizontalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="12,10" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="3,0,3,4">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Fan 2" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Draft  /  estimated RPM" Foreground="{DynamicResource StudioMutedText}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Fan2Rpm" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource StudioFanTwo}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="live RPM" Foreground="{DynamicResource StudioMutedText}" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom"/>
                  </StackPanel>
                </Grid>
                <Grid x:Name="GpuPlot" Grid.Row="1"/>
                <TextBlock Grid.Row="2" Text="Temperature (°C)" Foreground="{DynamicResource StudioMutedText}" HorizontalAlignment="Center"/>
              </Grid>
            </Border>
          </UniformGrid>

          <Border x:Name="PreviewPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="10,6">
 <StackPanel><TextBlock Text="Temperature preview" FontWeight="SemiBold" ToolTip="Hypothetical temperatures. Response delays and thermal protection affect measured speeds."/>
 <UniformGrid Columns="2" Margin="0,4,0,0"><StackPanel Margin="4,0"><DockPanel><TextBlock x:Name="PreviewCpuValue" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="CPU" Style="{StaticResource Eyebrow}"/></DockPanel>
 <Slider x:Name="PreviewCpu" Minimum="20" Maximum="100" Value="75" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="Preview CPU temperature"/></StackPanel><StackPanel Margin="4,0"><DockPanel><TextBlock x:Name="PreviewGpuValue" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="GPU" Style="{StaticResource Eyebrow}"/></DockPanel>
 <Slider x:Name="PreviewGpu" Minimum="20" Maximum="100" Value="75" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="Preview GPU temperature"/></StackPanel></UniformGrid>
 <UniformGrid Columns="2"><TextBlock x:Name="PreviewFan1" Margin="4,0" Foreground="{DynamicResource StudioAccent}" TextWrapping="Wrap"/><TextBlock x:Name="PreviewFan2" Margin="4,0" Foreground="{DynamicResource StudioFanTwo}" TextWrapping="Wrap"/></UniformGrid></StackPanel></Border>
          <ComboBox x:Name="YAxis" SelectedIndex="1" Visibility="Collapsed">
            <ComboBoxItem Content="RPM"/><ComboBoxItem x:Name="RpmAxis" Content="RPM" IsEnabled="False"/>
          </ComboBox>
          <Border x:Name="PointPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="13,9" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SelectedPoint" Text="Fan 1 · point 1" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="PointTemperature" Width="64" Style="{StaticResource CurveNumber}" AutomationProperties.Name="Point temperature"/>
                <TextBlock Text="°C" Foreground="{DynamicResource StudioMutedText}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                <TextBox x:Name="PointValue" Width="94" Style="{StaticResource CurveNumber}" AutomationProperties.Name="Point fan speed"/>
                <TextBlock x:Name="PointUnit" Text="RPM" Foreground="{DynamicResource StudioMutedText}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                <Button x:Name="SetPoint" Content="Update point"/>
              </StackPanel>
            </Grid>
          </Border>

        </Grid>

        <Grid x:Name="AdvancedDrawer" Grid.Column="1" Width="0" ClipToBounds="True" Visibility="Collapsed">
          <Border x:Name="AdvancedPanel" Width="282" HorizontalAlignment="Left" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioLine}" BorderThickness="1,0,0,0">
            <DockPanel>
              <Button x:Name="CurveDefaults" DockPanel.Dock="Bottom" Content="Reset draft curves"
                      Margin="17,6,17,14" Style="{StaticResource PrimaryButton}"
                      ToolTip="Restore the default points for both draft fan curves."/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="17,16,17,16">
                  <CheckBox x:Name="ClampGrid" Content="Snap to grid" IsChecked="True" Margin="0,0,0,10"/>
                  <TextBlock Text="Sensors" FontWeight="SemiBold" Margin="0,6,0,8"/>
                  <CheckBox x:Name="SharedControl" Content="Shared fan control" IsChecked="True"/>
                  <TextBlock x:Name="FanResponseHelp" Foreground="{DynamicResource StudioMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
                  <TextBlock x:Name="SharedTarget" Foreground="{DynamicResource StudioMutedText}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Fan 1 source" FontSize="11" Margin="0,0,0,4"/>
                      <ComboBox x:Name="Fan1Source" SelectedIndex="0"><ComboBoxItem Content="Hotter"/><ComboBoxItem Content="CPU"/><ComboBoxItem Content="GPU"/></ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Fan 2 source" FontSize="11" Margin="0,0,0,4"/>
                      <ComboBox x:Name="Fan2Source" SelectedIndex="0"><ComboBoxItem Content="Hotter"/><ComboBoxItem Content="CPU"/><ComboBoxItem Content="GPU"/></ComboBox>
                    </StackPanel>
                  </Grid>
                  <CheckBox x:Name="CpuFallback" Content="Use CPU if GPU is unavailable"/>
                  <TextBlock Text="Fan response" FontWeight="SemiBold" Margin="0,18,0,8"/>
                  <DockPanel><TextBlock x:Name="ShiftValue" DockPanel.Dock="Right" Foreground="{DynamicResource StudioAccent}"/><TextBlock Text="Fan shift"/></DockPanel>
                  <Slider x:Name="FanShift" Minimum="0" Maximum="100" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ToolTip="Blend each fan's sensor with the hotter temperature."/>
                  <DockPanel Margin="0,4,0,0"><TextBlock x:Name="UpValue" DockPanel.Dock="Right" Foreground="{DynamicResource StudioAccent}"/><TextBlock Text="Speed-up delay"/></DockPanel>
                  <Slider ToolTip="How long rising demand must persist before speeding up." x:Name="HysteresisUp" Minimum="0" Maximum="15" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
                  <DockPanel Margin="0,4,0,0"><TextBlock x:Name="DownValue" DockPanel.Dock="Right" Foreground="{DynamicResource StudioAccent}"/><TextBlock Text="Slow-down delay"/></DockPanel>
                  <Slider ToolTip="How long falling demand must persist before slowing down." x:Name="HysteresisDown" Minimum="0" Maximum="60" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"/>
                  <TextBlock Text="RPM calibration" FontWeight="SemiBold" Margin="0,18,0,0"/>
                  <TextBlock Text="Requires NVIDIA GPU temperature" Style="{StaticResource Detail}" Margin="0,4,0,9"/>
                  <Button x:Name="Calibrate" Content="Measure max RPM" ToolTip="Start only when idle and cool. Runs the fans at full duty."/>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid Grid.Row="3" Margin="15,0,15,8">
        <Grid x:Name="PresetPanel" Height="34">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Presets" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ComboBox x:Name="PresetList" Grid.Column="1" AutomationProperties.Name="Saved curve presets"
                    ToolTip="Select a preset to load it into the draft"/>
          <Button x:Name="UpdatePreset" Grid.Column="2" Content="Update" Margin="5,0,0,0" Padding="4,4"
                  ToolTip="Replace the saved preset with this draft" ToolTipService.ShowOnDisabled="True"/>
          <Button x:Name="RenamePreset" Grid.Column="3" Content="Rename" Margin="5,0,0,0" Padding="4,4"
                  ToolTip="Rename the selected preset" ToolTipService.ShowOnDisabled="True"/>
          <Button x:Name="DeletePreset" Grid.Column="4" Content="Delete" Margin="5,0,0,0" Padding="4,4"
                  ToolTip="Review and confirm deletion" ToolTipService.ShowOnDisabled="True"/>
          <Button x:Name="NewPreset" Grid.Column="6" Content="Save as preset…" Width="132" Padding="12,4"
                  ToolTip="Save a copy of the current draft"/>
        </Grid>
        <StackPanel x:Name="PresetForm" Visibility="Collapsed">
          <Grid MinHeight="34">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PresetFormLabel" Text="Preset name" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="PresetName" Grid.Column="1" MaxLength="40" AutomationProperties.Name="Preset name"/>
            <Button x:Name="CancelPreset" Grid.Column="2" Content="Cancel" Margin="8,0,0,0" Padding="12,4"/>
            <Button x:Name="SavePreset" Grid.Column="3" Content="Save preset" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" Padding="12,4"/>
          </Grid>
          <TextBlock x:Name="PresetError" Visibility="Collapsed" Margin="0,5,0,0" Foreground="{DynamicResource StudioWarningText}"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="4" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioLine}" BorderThickness="0,1,0,0" Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StopCurve" Content="Stop curve" Background="{StaticResource StopBackground}" BorderBrush="{StaticResource StopBorder}"
                    Foreground="#FFFFFF" AutomationProperties.Name="Stop running fan curve"/>
            <Button x:Name="CancelCalibration" Content="Cancel calibration" Visibility="Collapsed" Margin="8,0,0,0"/>
          </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock x:Name="CurveStatus" Foreground="{DynamicResource StudioMutedText}" TextWrapping="Wrap"/>
              <ProgressBar x:Name="CalibrationProgress" Height="3" Minimum="0" Maximum="100" Background="{DynamicResource StudioControl}" Foreground="{DynamicResource StudioAccent}" BorderThickness="0" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          <Button x:Name="SaveCurve" Grid.Column="2" Content="Start curve" Style="{StaticResource PrimaryButton}"
                  Background="{DynamicResource StudioAccent}" Foreground="{DynamicResource StudioOnAccent}"
                  VerticalAlignment="Center" Padding="16,8"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
